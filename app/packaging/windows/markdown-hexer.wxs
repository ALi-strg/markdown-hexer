<?xml version="1.0" encoding="utf-8"?>
<!--
  Windows file associations for the MSI, matching docs/os-associations.md.
  cargo-packager's WiX template emits no ProgId for `file-associations`
  (it reads a field that does not exist), so the associations live here.
  Keep in sync with the file-associations table in app/Cargo.toml and the NSIS
  template.
-->
<Wix xmlns="http://schemas.microsoft.com/wix/2006/wi">
  <Fragment>
    <DirectoryRef Id="INSTALLDIR">
      <Component Id="MarkdownHexerFileAssociations" Guid="5f8a70d2-7850-4120-af0c-73e5d29b3231">
        <RegistryKey Root="HKLM" Key="Software\Classes\MarkdownHexer.Document">
          <RegistryValue Type="string" Value="Markdown document" KeyPath="yes" />
          <RegistryValue Name="FriendlyTypeName" Type="string" Value="Markdown Hexer document" />
          <RegistryKey Key="DefaultIcon">
            <RegistryValue Type="string" Value="&quot;[INSTALLDIR]markdown-hexer.exe&quot;,0" />
          </RegistryKey>
          <RegistryKey Key="shell\open">
            <RegistryValue Type="string" Value="Open with Markdown Hexer" />
            <RegistryKey Key="command">
              <RegistryValue Type="string" Value="&quot;[INSTALLDIR]markdown-hexer.exe&quot; &quot;%1&quot;" />
            </RegistryKey>
          </RegistryKey>
        </RegistryKey>
        <RegistryKey Root="HKLM" Key="Software\Classes\.md">
          <RegistryValue Type="string" Value="MarkdownHexer.Document" />
        </RegistryKey>
        <RegistryKey Root="HKLM" Key="Software\Classes\.markdown">
          <RegistryValue Type="string" Value="MarkdownHexer.Document" />
        </RegistryKey>
        <RegistryKey Root="HKLM" Key="Software\Classes\.mdown">
          <RegistryValue Type="string" Value="MarkdownHexer.Document" />
        </RegistryKey>
      </Component>
    </DirectoryRef>
  </Fragment>

  <Fragment>
    <ComponentGroup Id="MarkdownHexerFileAssociations">
      <ComponentRef Id="MarkdownHexerFileAssociations" />
    </ComponentGroup>
  </Fragment>
</Wix>
